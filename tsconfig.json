{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@app/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@env": [
        "src/environments/environment"
      ],
      "@modules/*": [
        "src/app/modules/*"
      ],
      "@data/*": [
        "src/app/data/*"
      ],
      "@layout/*": [
        "src/app/layout/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  }
}
